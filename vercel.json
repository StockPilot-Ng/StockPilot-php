{
    "version": 2,
    "framework": "laravel",
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],
    {
      "outputDirectory": "public"
    }

    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.0"
        }
    }
}
