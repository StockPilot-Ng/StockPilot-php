{
    "version": 2,
    "routes": [
        { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
        { "src": "/(.*)\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|otf|txt|csv)$", "dest": "/public/$1.$2" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.0"
        }
    }
}
